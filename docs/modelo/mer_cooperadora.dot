  { rank=same; operaciones -> usuarios -> ejercicios -> carreras [style=invis]; }
  { rank=same; carrera_anios -> pagos_grupales -> fondos [style=invis]; }
  { rank=same; aportantes -> solicitudes_fondo [style=invis]; }
  { rank=same; pagos -> saldos_aportantes [style=invis]; }
  { rank=same; verificaciones -> recibos -> libretas -> movimientos_fondo -> auditoria [style=invis]; }

  operaciones:head -> pagos:operacion_id [label="respalda", arrowtail=teetee, arrowhead=teeodot, color="#9c3f1a"];
  operaciones:head -> pagos_grupales:operacion_id [label="respalda", arrowtail=teetee, arrowhead=teeodot, color="#9c3f1a"];
  carreras:head -> carrera_anios:carrera_id [label="se dicta en", arrowtail=teetee, arrowhead=crowodot, color="#4f6142"];
  carreras:head -> fondos:carrera_id [label="tiene fondo", arrowtail=teeodot, arrowhead=crowodot, color="#4f6142"];
  carreras:head -> solicitudes_fondo:carrera_id [label="origina", arrowtail=teeodot, arrowhead=crowodot, color="#4f6142"];
  carrera_anios:head -> aportantes:carrera_id [label="ubica a", arrowtail=teeodot, arrowhead=crowodot, color="#4f6142"];
  ejercicios:head -> pagos:ejercicio_id [label="imputa", arrowtail=teetee, arrowhead=crowodot, color="#4f6142"];
  ejercicios:head -> saldos_aportantes:ejercicio_id [label="corresponde a", arrowtail=teetee, arrowhead=crowodot, color="#4f6142"];
  aportantes:head -> pagos:aportante_id [label="realiza", arrowtail=teetee, arrowhead=crowodot, color="#9c3f1a"];
  aportantes:head -> saldos_aportantes:aportante_id [label="acumula", arrowtail=teetee, arrowhead=crowodot, color="#9c3f1a"];
  pagos_grupales:head -> pagos:pago_grupal_id [label="reparte en", arrowtail=teeodot, arrowhead=crowodot, color="#9c3f1a"];
  pagos_grupales:head -> verificaciones:pago_grupal_id [label="se verifica", arrowtail=teeodot, arrowhead=crowodot, color="#9c3f1a"];
  pagos:head -> verificaciones:pago_id [label="se verifica", arrowtail=teeodot, arrowhead=crowodot, color="#9c3f1a"];
  pagos:head -> recibos:pago_id [label="emite", arrowtail=teetee, arrowhead=teeodot, color="#9c3f1a"];
  pagos:head -> movimientos_fondo:pago_id [label="origina", arrowtail=teeodot, arrowhead=crowodot, color="#9c3f1a"];
