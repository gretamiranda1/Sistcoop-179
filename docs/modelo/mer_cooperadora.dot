digraph DER {
  graph [rankdir=LR, splines=spline, nodesep=0.3, ranksep=0.75,
         fontname="DejaVu Sans", bgcolor="white", pad=0.35, compound=true];
  node  [shape=plaintext, fontname="DejaVu Sans", fontsize=27];
  edge  [decorate=true, fontname="DejaVu Sans", fontsize=23, color="#4a5a42", penwidth=1.6, arrowsize=1.1, dir=both, fontcolor="#2f3a2b"];

  operaciones [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#5a5a5a">
    <TR><TD PORT="head" COLSPAN="2" BGCOLOR="#a8461f"><FONT COLOR="#ffffff" POINT-SIZE="31"><B>operaciones</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">id</TD><TD ALIGN="RIGHT" BGCOLOR="#ffffff"><FONT COLOR="#ad4a26" POINT-SIZE="23"><B>PK</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#f5f7f1">codigo_transaccion</TD><TD ALIGN="RIGHT" BGCOLOR="#f5f7f1"><FONT COLOR="#8a6a12" POINT-SIZE="23"><B>UK</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">hash_comprobante</TD><TD ALIGN="RIGHT" BGCOLOR="#ffffff"><FONT COLOR="#8a6a12" POINT-SIZE="23"><B>UK</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#f5f7f1">importe</TD><TD ALIGN="RIGHT" BGCOLOR="#f5f7f1"> </TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#ffffff">cuit_ordenante</TD><TD ALIGN="RIGHT" BGCOLOR="#ffffff"><FONT COLOR="#8a8a8a" POINT-SIZE="21">quien transfirió</FONT></TD></TR>
    <TR><TD ALIGN="LEFT" BGCOLOR="#f5f7f1">alcance</TD><TD ALIGN="RIGHT" BGCOLOR="#f5f7f1"> </TD></TR>
    </TABLE>>];
  usuarios [label=<
    <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#5a5a5a">
