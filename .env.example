# ---------------------------------------------------------------
# SistCoop 179 — plantilla de variables de entorno
#
# Copiar como ".env" y completar. El archivo ".env" NO se versiona.
# ---------------------------------------------------------------

# Clave secreta de Flask (firma de sesiones y tokens CSRF).
# Generá una distinta por entorno con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# En producción la aplicación no arranca si falta o si tiene menos de
# 32 caracteres.
SECRET_KEY=

# Entorno: development | production | testing
FLASK_ENV=development

# Conexión a PostgreSQL.
# Formato: postgresql://usuario:contrasena@host:puerto/nombre_base
# En desarrollo se puede dejar vacío: la app usa SQLite en instance/.
DATABASE_URL=

# Carpeta donde se guardan los comprobantes.
# IMPORTANTE: tiene que estar FUERA de app/static/. Todo lo que está en
# static lo sirve el servidor a cualquiera que conozca la URL, y un
# comprobante bancario contiene datos personales y de cuenta.
UPLOAD_FOLDER=instance/comprobantes

# Tamaño máximo de un comprobante, en bytes (16 MB).
MAX_CONTENT_LENGTH=16777216
